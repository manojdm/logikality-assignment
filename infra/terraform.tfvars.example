project_name          = "logikality"
environment           = "dev"
aws_region            = "us-east-1"
owner                 = "founding-devops"
max_receive_count     = 5
visibility_timeout    = 300
age_threshold_seconds = 900
enable_access_logging = true
enable_object_lock    = false
enable_github_oidc    = false
