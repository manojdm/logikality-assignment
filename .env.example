# Copy to .env for local runs. Never commit .env.
APP_ENV=local
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
DOCUMENT_BUCKET=logikality-documents
QUEUE_URL=http://localhost:4566/000000000000/logikality-processing
IDEMPOTENCY_TABLE=logikality-idempotency
LOG_LEVEL=INFO
APP_VERSION=dev
MAX_UPLOAD_BYTES=10485760
PROCESSING_DELAY_SECONDS=0
FAILURE_RATE=0
